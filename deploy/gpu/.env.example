# manage.py init replaces these paths and generates a shared internal key.
AI_INTERNAL_KEY=__GENERATE__
SERPAPI_API_KEY=
# Gated base model: grant access on Hugging Face and set your token for first download.
HF_TOKEN=
HF_HUB_OFFLINE=0
POLICY_MODEL_DIR=__ROOT__/data/models/policy
CUSTOMER_ADAPTER_DIR=__ROOT__/data/models/customer
CUSTOMER_DOCUMENTS_DIR=__ROOT__/data/store-docs
CUSTOMER_STORE_ALIASES_FILE=__ROOT__/services/customer/store-aliases.json
POLICY_GPU_ID=0
CUSTOMER_GPU_ID=0
POLICY_SEARCH_ENGINE=naver
POLICY_REQUEST_TIMEOUT=85
CUSTOMER_MAX_WAITING=32
# Loopback for SSH tunnels. For private networking, set the AI server's private IPv4.
GRPC_BIND_HOST=127.0.0.1
POLICY_PORT=50051
CUSTOMER_PORT=50053
STARTUP_TIMEOUT=1800
